<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@drawable/fondo_degradado">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/altura_minima_pantalla"
        android:padding="20dp">

        <!-- ================= TARJETA LOGIN ================= -->
        <androidx.cardview.widget.CardView
            android:id="@+id/tarjetaLogin"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:cardCornerRadius="24dp"
            app:cardElevation="10dp"
            app:cardUseCompatPadding="true"
            app:cardBackgroundColor="@android:color/white"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="28dp">

                <!-- ICONO -->
                <ImageView
                    android:layout_width="90dp"
                    android:layout_height="90dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_login_escudo"
                    android:contentDescription="Logo"/>

                <!-- TITULO -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="INICIO DE SESIÓN"
                    android:textStyle="bold"
                    android:textSize="20sp"
                    android:gravity="center"
                    android:textColor="@color/colorPrimario"
                    android:layout_marginTop="10dp"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Accede a tu cuenta"
                    android:gravity="center"
                    android:textSize="13sp"
                    android:textColor="@android:color/darker_gray"
                    android:layout_marginBottom="18dp"/>

                <!-- ================= USUARIO ================= -->
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:startIconDrawable="@drawable/ic_persona"
                    app:boxBackgroundMode="outline"
                    app:boxStrokeColor="@color/colorPrimario">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/campoNombreUsuario"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Usuario"
                        android:inputType="text"
                        android:padding="12dp"/>
                </com.google.android.material.textfield.TextInputLayout>

                <!-- ================= CONTRASEÑA ================= -->
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    app:startIconDrawable="@drawable/ic_candado"
                    app:endIconMode="password_toggle"
                    app:boxBackgroundMode="outline"
                    app:boxStrokeColor="@color/colorPrimario">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/campoContrasena"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Contraseña"
                        android:inputType="textPassword"
                        android:padding="12dp"/>
                </com.google.android.material.textfield.TextInputLayout>

                <!-- ================= RECORDAR ================= -->
                <CheckBox
                    android:id="@+id/checkRecordar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Mantener sesión iniciada"
                    android:layout_marginTop="10dp"
                    android:buttonTint="@color/colorPrimario"/>

                <!-- ================= LOGIN ================= -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/botonIniciarSesion"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:text="INICIAR SESIÓN"
                    android:textStyle="bold"
                    android:textColor="@android:color/white"
                    android:layout_marginTop="16dp"
                    app:cornerRadius="14dp"
                    app:backgroundTint="@color/colorPrimario"/>

                <!-- ================= CREAR CUENTA ================= -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/botonCrearCuenta"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:text="Crear cuenta"
                    android:layout_marginTop="10dp"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"/>

                <!-- ================= ACERCA DE ================= -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/botonAcercaDe"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:text="Acerca de"
                    android:layout_marginTop="8dp"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"/>

                <!-- ================= BORRAR DATOS ================= -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_Cerrar"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:text="Borrar datos"
                    android:textColor="@android:color/white"
                    android:layout_marginTop="12dp"
                    app:backgroundTint="@android:color/holo_red_dark"
                    app:cornerRadius="14dp"/>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </androidx.constraintlayout.widget.ConstraintLayout>

</ScrollView>